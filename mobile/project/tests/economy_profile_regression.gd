extends SceneTree
const Profile = preload("res://economy_profile.gd")
var checks := 0
var failures: Array[String]=[]
var paths: Array[String]=[]
func check(ok: bool, message: String) -> void:
	checks+=1
	if ok: print("PASS: "+message)
	else:
		failures.append(message)
		push_error("FAIL: "+message)
func path(label: String) -> String:
	var name := "/tmp/dustline-profile-%d-%s.json" % [OS.get_process_id(),label]
	paths.append(name)
	return name
func write(name: String, content: String) -> void:
	var file := FileAccess.open(name,FileAccess.WRITE)
	file.store_string(content)
	file.close()
func _initialize() -> void:
	var location := path("main")
	var p=Profile.new(location)
	check(p.assets==0 and p.levels==[1,1,1,1,1,1,1,1] and p.ammo_stock==0,"Fresh profile starts clean")
	check(not p.purchase("repulsor").ok and not p.upgrade(0).ok and p.assets==0,"Insufficient funds cannot spend or create debt")
	check(not p.purchase("unknown").ok and not p.upgrade(-1).ok and not p.equip("repulsor").ok,"Invalid requests and unowned equipment are rejected")
	var departure: Dictionary=p.begin_expedition()
	check(departure.ok and departure.ammo==0 and departure.id.length()==32,"Departure creates unique persisted token")
	check(not p.begin_expedition().ok and not p.purchase("field_kit").ok and not p.upgrade(0).ok,"Ongoing expedition blocks new token and camp spending")
	var value: Dictionary=p.finish_expedition(departure.id,true,2400,0)
	check(value.ok and p.assets==2400 and p.pending.is_empty(),"Success banks assets and clears expedition atomically")
	check(p.settle(departure.id,2400).banked==0 and p.assets==2400,"Duplicate settlement cannot award again")
	p=Profile.new(location)
	check(p.assets==2400 and p.settle(departure.id,2400).banked==0,"Idempotence survives reload")
	check(not p.settle("unknown",500).ok and p.assets==2400,"Unknown expedition cannot mint assets")
	check(not p.purchase("ammo_pack").ok,"Ammunition requires owning the firearm")
	check(p.purchase("repulsor").ok and p.equipped=="repulsor" and p.ammo_stock==12 and p.assets==2100,"Gun purchase equips and grants exactly initial twelve rounds")
	check(not p.purchase("repulsor").ok and p.assets==2100 and p.ammo_stock==12,"Buying owned gun cannot repeat initial ammunition grant")
	check(p.equip("").ok and p.equipped=="","Weapon can be put away")
	departure=p.begin_expedition()
	check(departure.ammo==0 and p.ammo_stock==12,"Unarmed expedition does not reserve ammunition")
	p.finish_expedition(departure.id,false,100,99)
	check(p.assets==2100 and p.ammo_stock==12,"Failure pays nothing and cannot refund unissued ammunition")
	p.equip("repulsor")
	p.purchase("ammo_pack")
	departure=p.begin_expedition()
	check(departure.ammo==12 and p.ammo_stock==12,"Each round reserves at most twelve rounds from stock")
	p.finish_expedition(departure.id,false,180,7)
	check(p.assets==2010 and p.ammo_stock==19,"Normal failure returns remaining rounds without selling loot")
	p.finish_expedition(departure.id,false,180,7)
	check(p.ammo_stock==19,"Repeated settlement cannot duplicate returned rounds")
	check(p.purchase("armor").ok and p.purchase("field_kit").ok and p.assets==1670,"Permanent supplies cost correct assets")
	for rank in 4: check(p.upgrade(2).ok,"Character level step %d commits"%(rank+1))
	check(p.level(2)==5 and p.level(0)==1 and p.level(1)==1 and p.level(3)==1 and p.assets==470,"Growth affects only one survivor with rising upgrade costs")
	check(p.max_health(2)==160 and is_equal_approx(p.cooldown_multiplier(2),.72),"Maximum level grants sixty health and twenty-eight percent cooldown reduction")
	check(not p.upgrade(2).ok and p.assets==470,"Maximum level cannot be charged again")
	p=Profile.new(location)
	check(p.assets==470 and p.level(2)==5 and p.equipped=="repulsor" and p.owned.size()==3 and p.ammo_stock==19,"All growth equipment currency and ammo survive reload")
	departure=p.begin_expedition()
	p=Profile.new(location)
	check(p.pending.is_empty() and p.assets==470 and p.ammo_stock==7 and not p.load_message.is_empty(),"Interrupted application abandons bag and reserved rounds without altering bank")
	check(p.settle(departure.id,500).banked==0 and p.assets==470,"Abandoned token cannot later settle loot")
	var oldpath: String=p.save_path
	p.save_path="/tmp/no-such-dustline-directory-%d/profile.json" % OS.get_process_id()
	var before: Dictionary=p._snapshot()
	check(not p.upgrade(0).ok and p._snapshot()==before,"Failed save rolls back growth and cost")
	check(not p.purchase("ammo_pack").ok and p._snapshot()==before,"Failed save rolls back ammunition purchase")
	check(not p.begin_expedition().ok and p._snapshot()==before,"Failed departure save restores reserved ammo and pending token")
	p.save_path=oldpath
	departure=p.begin_expedition()
	before=p._snapshot()
	p.save_path="/tmp/no-such-dustline-directory-%d/profile.json" % OS.get_process_id()
	check(not p.finish_expedition(departure.id,true,100,4).ok and p._snapshot()==before,"Failed settlement preserves exact pending transaction for retry")
	p.save_path=oldpath
	check(p.finish_expedition(departure.id,true,100,4).ok and p.assets==570,"Settlement retry commits once storage is restored")
	var backup_before: Dictionary=JSON.parse_string(FileAccess.get_file_as_string(location+".bak"))
	write(location,"{CORRUPT}")
	p=Profile.new(location)
	check(not p.read_only and p.assets==int(backup_before.assets) and not p.load_message.is_empty(),"Corrupt primary recovers valid backup and reports recovery")
	check(FileAccess.get_file_as_string(location)=="{CORRUPT}" or p._main_valid,"Corrupt file is retained or replaced only after preservation")
	var broken := path("broken")
	write(broken,"BROKEN")
	write(broken+".bak","ALSO BROKEN")
	var blocked=Profile.new(broken)
	check(blocked.read_only and not blocked.begin_expedition().ok and FileAccess.get_file_as_string(broken)=="BROKEN","Unreadable save pair is preserved and mutation is disabled")
	var legacy_path := path("legacy")
	var legacy: Dictionary=p._snapshot()
	legacy.levels=[2,3,1,4]
	legacy.pending={}
	write(legacy_path,JSON.stringify(legacy))
	var migrated=Profile.new(legacy_path)
	check(migrated.levels==[2,3,1,4,1,1,1,1] and migrated.assets==p.assets,"Legacy four-survivor progress extends to eight without losing assets")
	var malformed := path("malformed")
	var bad: Dictionary=p._snapshot()
	bad.assets=-10
	write(malformed,JSON.stringify(bad))
	var invalid=Profile.new(malformed)
	check(invalid.read_only,"Structurally invalid save cannot create negative assets")
	var death_path := path("death")
	var survivor=Profile.new(death_path)
	var funding: Dictionary=survivor.begin_expedition()
	survivor.finish_expedition(funding.id,true,3000,0)
	for item in ["repulsor","armor","field_kit","ammo_pack"]: survivor.purchase(item)
	survivor.upgrade(0)
	var safe: Dictionary=survivor.begin_expedition()
	survivor.finish_expedition(safe.id,true,100,9)
	check(survivor.owned.size()==3 and survivor.ammo_stock==21,"Successful extraction keeps purchased gear and refunds only remaining ammo")
	var fatal: Dictionary=survivor.begin_expedition()
	var balance: int=survivor.assets
	var original: Dictionary=survivor._snapshot()
	survivor.save_path="/tmp/no-such-dustline-directory-%d/death.json"%OS.get_process_id()
	check(not survivor.finish_expedition(fatal.id,false,400,7,true).ok and survivor._snapshot()==original,"Death save failure rolls back gear and currency together for retry")
	survivor.save_path=death_path
	var death: Dictionary=survivor.finish_expedition(fatal.id,false,400,7,true)
	check(death.ok and death.lost_equipment.size()==3 and death.lost_ammo==16 and death.returned_ammo==0,"Death report lists actual equipment and remaining ammo lost")
	check(survivor.owned.is_empty() and survivor.equipped.is_empty() and survivor.ammo_stock==0,"Death destroys purchased gear including camp ammunition")
	check(survivor.assets==balance and survivor.level(0)==2,"Death preserves bank and permanent character growth")
	survivor=Profile.new(death_path)
	check(survivor.owned.is_empty() and survivor.ammo_stock==0 and survivor.pending.is_empty(),"Death equipment loss survives application restart")
	check(not survivor.equip("repulsor").ok and not survivor.purchase("ammo_pack").ok,"Lost gun cannot be equipped or supplied until repurchased")
	check(survivor.purchase("repulsor").ok and survivor.assets==balance-300 and survivor.ammo_stock==12,"Repurchase charges full price and grants only a new gun's twelve rounds")
	survivor.finish_expedition(fatal.id,false,400,7,true)
	check(survivor.owned.has("repulsor") and survivor.ammo_stock==12,"Duplicate death settlement cannot destroy newly repurchased equipment")
	survivor.equip("")
	var unarmed: Dictionary=survivor.begin_expedition()
	survivor.finish_expedition(unarmed.id,false,0,0,true)
	check(survivor.owned.is_empty() and survivor.ammo_stock==0,"Death also clears owned gun when holstered")
	for name in paths:
		for suffix in ["",".bak",".tmp",".bak.tmp"]: DirAccess.remove_absolute(name+suffix)
		var directory:=DirAccess.open("/tmp")
		for entry in directory.get_files():
			if entry.begins_with(name.get_file()+".corrupt-"): DirAccess.remove_absolute("/tmp/"+entry)
	print("ECONOMY PROFILE: %s; %d checks; %d failures" % ["PASS" if failures.is_empty() else "FAIL",checks,failures.size()])
	quit(0 if failures.is_empty() else 1)
